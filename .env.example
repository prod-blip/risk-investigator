# Copy this file to .env and fill in the key locally. Never commit .env.
OPENAI_API_KEY=
# A small model for initial smoke tests; choose another compatible model if preferred.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PRICING_MODEL=gpt-4.1-mini
# USD per million tokens, for local estimates. Verify rates before live runs.
# Source: https://developers.openai.com/api/docs/models/gpt-4.1-mini
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
